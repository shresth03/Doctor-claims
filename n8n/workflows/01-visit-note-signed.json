    },
    {
      "parameters": {
        "jsCode": "const events = ($json.rows ?? []).map((r) => ({\n  type: 'notification.created',\n  notification: { id: `NTF-${r.id}`, kind: r.kind, severity: r.severity, title: r.title, message: r.message, claimId: r.claim_id ?? undefined, createdAt: r.created_at },\n}));\nreturn [{ json: { events } }];"
      },
