        "query": "INSERT INTO audit_events (actor, actor_type, event, entity, claim_id, metadata)\nVALUES ('Workflow Engine', 'system', 'Duplicate trigger suppressed', 'Doc request ' || $1::text, $2::text,\n        jsonb_build_object('dedup_key', $2::text || '+' || $1::text, 'suppressed_by', 'claim_id + request_id'))",
