        "query": "INSERT INTO dedup_keys (key, meta) VALUES ($1, $2::jsonb) ON CONFLICT (key) DO NOTHING RETURNING key",
        "options": {
          "queryReplacement": "={{ [ $json.dedup_key, JSON.stringify({ source: 'visit-note-signed', run_id: $json.run_id }) ] }}"
        }
