    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(SUM(changed_count),0)::int AS changed, COALESCE(SUM(proposed_count),0)::int AS proposed, COUNT(*)::int AS sample_size\nFROM claim_metrics WHERE submitted_at > now() - interval '30 days'",
        "options": {}
      },
      "id": "6dd03c34-d768-59d1-9ba6-fa70f88d4e63",
      "name": "Doctor edit rate (current)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        260,
        2040
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Claims DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (submitted_at - note_signed_at))/3600) AS median_hours,\n       PERCENTILE_CONT(0.9) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (submitted_at - note_signed_at))/3600) AS p90_hours\nFROM claim_metrics WHERE submitted_at > now() - interval '30 days' AND note_signed_at IS NOT NULL",
        "options": {}
      },
      "id": "1f97f50b-4e85-5ddf-8f9a-4dd353763b81",
      "name": "Latency (current)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        2040
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Claims DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  (SELECT count(*) FROM claims WHERE draft_generated_at > now() - interval '30 days')::int AS claims_processed_30d,\n  (SELECT count(*) FROM claims WHERE status IN ('pending_review','partially_reviewed'))::int AS pending_doctor_reviews,\n  (SELECT COALESCE(sum(regeneration_count),0) FROM claims WHERE draft_generated_at > now() - interval '30 days')::int AS regeneration_count_30d,\n  (SELECT count(*) FROM audit_events WHERE event = 'Code quarantined \u2014 validation failed' AND ts > now() - interval '30 days')::int AS validation_failures_30d,\n  (SELECT count(*) FROM doc_requests WHERE status NOT IN ('submitted','sla_breach') AND due_at < now() + interval '24 hours')::int AS sla_approaching,\n  (SELECT count(*) FROM audit_events WHERE event = 'Reconciliation discrepancy found' AND ts > now() - interval '30 days')::int AS reconciliation_discrepancies",
        "options": {}
      },
      "id": "3da5814c-6443-591e-9daf-14f44e9a0434",
      "name": "Pipeline counters",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        780,
        2040
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Claims DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT captured_at, doctor_edit_rate, denial_rate_current, latency_median_hours FROM kpi_snapshots ORDER BY captured_at",
        "options": {}
      },
      "id": "6515caa3-7499-5f20-b66b-c54c119550d1",
      "name": "KPI history",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1040,
        2040
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Claims DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const edit = $('Doctor edit rate (current)').first().json;\nconst lat = $('Latency (current)').first().json;\nconst counts = $('Pipeline counters').first().json;\nconst history = $input.all().map((i) => i.json);\n\n// No 835/remittance feed exists yet (see Claims 09's own note) \u2014 the only denial-rate data\n// this system has at all is the seeded history. Use its latest point rather than invent one.\nconst lastDenial = [...history].reverse().find((h) => h.denial_rate_current != null);\nconst editRate = edit.proposed > 0 ? edit.changed / edit.proposed : (history.at(-1)?.doctor_edit_rate ?? 0);\nconst medianHours = Number(lat.median_hours ?? history.at(-1)?.latency_median_hours ?? 0);\n\nreturn [{ json: {\n  doctorEditRate: editRate,\n  doctorEditRateSampleSize: edit.sample_size || history.length,\n  doctorEditRateHistory: history.map((h) => ({ t: h.captured_at, value: Number(h.doctor_edit_rate) })),\n  denialRateCurrent: lastDenial ? Number(lastDenial.denial_rate_current) : 0,\n  denialRateBaseline: 0.058, // pre-automation reference constant \u2014 no live source for this either\n  denialRateHistory: history.filter((h) => h.denial_rate_current != null).map((h) => ({ t: h.captured_at, value: Number(h.denial_rate_current) })),\n  latencyMedianHours: medianHours,\n  latencyP90Hours: Number(lat.p90_hours ?? medianHours * 1.6),\n  latencyHistory: history.map((h) => ({ t: h.captured_at, value: Number(h.latency_median_hours) })),\n  claimsProcessed30d: counts.claims_processed_30d,\n  pendingDoctorReviews: counts.pending_doctor_reviews,\n  regenerationCount30d: counts.regeneration_count_30d,\n  validationFailures30d: counts.validation_failures_30d,\n  slaApproaching: counts.sla_approaching,\n  reconciliationDiscrepancies: counts.reconciliation_discrepancies,\n} }];"
      },
      "id": "070b3ff3-15d1-5a80-ac94-72fe6539f4a6",
      "name": "Build KPI response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        2040
