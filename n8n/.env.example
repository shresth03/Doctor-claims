# ── Wiring back to the frontend ──────────────────────────────────────────────
SELF_BASE_URL=https://n8n.internal.example.com
EVENT_RELAY_URL=http://localhost:8787
EVENT_RELAY_SECRET=change-me-long-random-string   # must match event-relay/server.mjs's EVENT_RELAY_SECRET

# ── Source systems n8n calls (never exposed to the frontend) ────────────────
EHR_BASE_URL=https://ehr.internal.example.com/api
PAYER_BASE_URL=https://payer-gateway.internal.example.com
BILLING_BASE_URL=https://billing.internal.example.com/api
CODE_CATALOG_URL=https://code-catalog.internal.example.com
RULES_URL=https://payer-rules.internal.example.com
EDI_SUBMIT_URL=https://clearinghouse.internal.example.com/837/submit

# Provider-agnostic AI/NLP extraction endpoint. Swap the model behind this URL freely —
# the frontend never sees a provider/model name outside metadata tooltips (see AI extraction adapter node).
AI_EXTRACTION_URL=https://ai-extraction-adapter.internal.example.com/extract

# ── Business rules ────────────────────────────────────────────────────────────
COMPLEXITY_RVU_THRESHOLD=2.5      # codes at/above this relative-value threshold get the high-complexity flag
WORKFLOW_VERSION=claims-pipeline-2026.09

# ── Alerting ──────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE
COMPLIANCE_ESCALATION_EMAIL=compliance-escalations@example.com

# ── n8n credentials (create these in the n8n UI; names must match exactly) ──
# Postgres        "Claims DB"                  → schema.sql applied to a Postgres 13+ database
# Header Auth      "Inbound system webhook auth" → shared secret the EHR/payer systems send inbound
# Header Auth      "Frontend webhook auth"       → shared secret the frontend sends on doctor-callback/regenerate/validate-code
# Header Auth      "EHR API", "Payer API", "Billing API", "Code catalog API", "Rules API",
#                  "EDI clearinghouse API", "AI extraction adapter", "Email API"
