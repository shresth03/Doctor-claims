    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO doc_requests (request_id, claim_id, insurer, patient_id, request_type, requested_docs, priority, status, received_at, due_at)\n  VALUES ($1, $2, $3, $4, $5, $6::jsonb, $7, 'new', $8::timestamptz, $9::timestamptz)\n  RETURNING request_id\n), n AS (\n  INSERT INTO notifications (kind, severity, title, message, claim_id, ref_id)\n  VALUES ('sla_breach', CASE WHEN $7 = 'urgent' THEN 'critical' ELSE 'info' END, 'New documentation request',\n          'Insurer ' || $3::text || ' requested ' || $5::text || ' for claim ' || $2::text || '.', $2, $1)\n  RETURNING id, kind, severity, title, message, claim_id, created_at\n), a AS (\n  INSERT INTO audit_events (actor, actor_type, event, entity, claim_id, run_id, metadata)\n  VALUES ('Workflow Engine', 'system', 'Insurer documentation request received', 'Doc request ' || $1::text, $2, $10,\n          jsonb_build_object('insurer', $3::text, 'request_type', $5::text, 'priority', $7::text, 'due_at', $9::text))\n  RETURNING id\n)\nSELECT COALESCE((SELECT to_jsonb(n) FROM n), '{}'::jsonb) AS notification",
        "options": {
          "queryReplacement": "={{ [ $json.request_id, $json.claim_id, $json.insurer, $json.patient_id, $json.request_type, JSON.stringify($json.requested_docs), $json.priority, $json.received_at, $json.due_at, $json.run_id ] }}"
        }
      },
      "id": "51e726d7-ac22-517d-b8ad-84ad1d9f1945",
      "name": "Insert request",
