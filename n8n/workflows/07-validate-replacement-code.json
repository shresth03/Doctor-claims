        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a66634cb-331f-503c-b0a4-d9be5a8796d0",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
