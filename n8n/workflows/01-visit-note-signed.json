      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nconst visitId = String(b.visit_id ?? '').trim();\nif (!visitId) throw new Error('visit_id is required');\nreturn [{ json: {\n  visit_id: visitId, mode: 'new',\n  run_id: `run_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`,\n  dedup_key: `${visitId}+draft_generated`,\n} }];"
      },
