    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH a AS (\n  INSERT INTO audit_events (actor, actor_type, event, entity, visit_id, run_id, metadata)\n  VALUES ('Workflow Engine', 'system', 'Duplicate trigger suppressed', 'Visit ' || $1::text, $1::text, $2::text,\n          jsonb_build_object('dedup_key', $3::text, 'suppressed_by', 'visit_id + claim_status'))\n  RETURNING id\n) SELECT count(*)::int AS written FROM a",
        "options": {
          "queryReplacement": "={{ [ $('Normalize').first().json.visit_id, $('Normalize').first().json.run_id, $('Normalize').first().json.dedup_key ] }}"
        }
      },
