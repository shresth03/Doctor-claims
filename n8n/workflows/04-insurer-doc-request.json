      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nconst errors = [];\nfor (const k of ['request_id', 'claim_id', 'insurer', 'request_type', 'due_at']) if (!b[k]) errors.push(`${k} is required`);\nreturn [{ json: {\n  valid: errors.length === 0, errors,\n  request_id: String(b.request_id ?? ''), claim_id: String(b.claim_id ?? ''), insurer: b.insurer,\n  patient_id: b.patient_id ?? null, request_type: b.request_type, requested_docs: b.requested_docs ?? [],\n  priority: b.priority ?? 'normal', received_at: b.received_at ?? new Date().toISOString(), due_at: b.due_at,\n  run_id: `run_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 8)}`,\n} }];"
      },
