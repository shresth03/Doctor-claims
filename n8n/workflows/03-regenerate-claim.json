    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO regen_locks (visit_id, claim_id, state, run_id, idem_key, requested_by, updated_at)\nVALUES ($1, $2, 'requested', $3, $4, $5, now())\nON CONFLICT (visit_id) DO UPDATE SET\n  state = 'requested', claim_id = EXCLUDED.claim_id, run_id = EXCLUDED.run_id,\n  idem_key = EXCLUDED.idem_key, requested_by = EXCLUDED.requested_by, updated_at = now()\nWHERE regen_locks.state NOT IN ('requested', 'running') OR regen_locks.updated_at < now() - interval '15 minutes'\nRETURNING run_id",
        "options": {
          "queryReplacement": "={{ [ $('Validate request').first().json.visitId, $('Validate request').first().json.claimId, $('Validate request').first().json.run_id, $('Validate request').first().json.idempotencyKey, $('Validate request').first().json.requestedBy ] }}"
