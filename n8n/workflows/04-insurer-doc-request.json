    },
    {
      "parameters": {
        "jsCode": "const n = $('Normalize').first().json;\nconst notif = $json.notification;\nconst events = [{ type: 'doc_request.created', request: { id: n.request_id, claimId: n.claim_id, insurer: n.insurer, requestType: n.request_type, priority: n.priority, dueAt: n.due_at, status: 'new' } }];\nif (notif?.id) events.push({ type: 'notification.created', notification: { id: `NTF-${notif.id}`, kind: notif.kind, severity: notif.severity, title: notif.title, message: notif.message, claimId: notif.claim_id ?? undefined, createdAt: notif.created_at } });\nreturn [{ json: { events } }];"
      },
