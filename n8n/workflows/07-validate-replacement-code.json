    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nconst errors = [];\nfor (const k of ['claimId', 'visitId', 'code']) if (!b[k] || typeof b[k] !== 'string') errors.push(`${k} is required`);\nreturn [{ json: { valid: errors.length === 0, errors, claimId: b.claimId, visitId: b.visitId, code: String(b.code ?? '').trim().toUpperCase() } }];"
      },
      "id": "83e3b227-576a-5d06-8bd2-daa2f91aa27f",
      "name": "Validate request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
