    {
      "parameters": {
        "jsCode": "const j = $json;\nconst n = $('Normalize').first().json;\nconst detail = j.detail ?? j.error?.message ?? 'The draft workflow failed unexpectedly.';\nreturn [{ json: { notifications: [{\n  kind: 'system', severity: 'warning', title: 'Draft could not be generated',\n  message: `Visit ${n.visit_id}: ${detail}`, claim_id: null, ref_id: n.visit_id,\n}] } }];"
      },
      "id": "99500254-1c3d-578d-9992-26de1552b7ce",
      "name": "Failure notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        340
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO notifications (kind, severity, title, message, claim_id, ref_id)\n  SELECT kind, severity, title, message, claim_id, ref_id\n  FROM jsonb_to_recordset($1::jsonb) AS x(kind text, severity text, title text, message text, claim_id text, ref_id text)\n  RETURNING id, kind, severity, title, message, claim_id, created_at\n)\nSELECT COALESCE(jsonb_agg(to_jsonb(ins)), '[]'::jsonb) AS rows FROM ins",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.notifications)] }}"
        }
      },
      "id": "96517817-f744-5884-9282-ba71e41a7114",
