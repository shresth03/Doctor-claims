    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.payload->'codes'->0->'validation' AS gates\nFROM claims c JOIN claim_drafts d ON d.claim_id = c.claim_id AND d.version = c.latest_version AND d.kind = 'draft'\nWHERE c.claim_id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.claimId ] }}"
        }
      },
      "id": "1f307899-2075-5ff0-9736-a591fb056137",
      "name": "Load draft gates",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
