        "jsCode": "// Read/acknowledged state is UI-session state today (mirrors how doctor code decisions aren't\n// persisted mid-review either \u2014 see Claims 02) \u2014 every fetch starts everything unread.\nreturn $input.all().map((i) => {\n  const r = i.json;\n  return { json: { id: `NTF-${r.id}`, kind: r.kind, title: r.title, message: r.message, createdAt: r.created_at, state: 'unread', claimId: r.claim_id ?? undefined, severity: r.severity } };\n});"
