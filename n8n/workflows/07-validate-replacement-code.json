        "postgres": {
          "id": "REPLACE_ME",
          "name": "Claims DB"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CODE_CATALOG_URL }}/lookup",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ codes: [$('Validate request').first().json.code] }) }}"
      },
      "id": "3f9a242b-68ac-59d9-a93a-9fe553dc4bc3",
      "name": "Catalog lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Code catalog API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const req = $('Validate request').first().json;\nconst stored = $('Load draft gates').first().json;\nconst cat = $input.first().json;\nconst code = req.code;\nconst isCpt = /^\\d{5}$/.test(code);\nconst isIcd = /^[A-TV-Z]\\d{2}(\\.[A-Z0-9]{1,4})?$/.test(code);\nconst entry = cat.error ? undefined : cat.codes?.[code];\nconst base = Array.isArray(stored.gates) ? stored.gates : [];\nconst carry = (key, label) => base.find((g) => g.key === key) ?? { key, label, status: 'unavailable', detail: 'This check could not be repeated for the current draft.' };\n\nlet doc;\nconst mk = (status, detail) => ({ key: 'documentation_requirement', label: 'Documentation requirement', status, detail });\nif (!isCpt && !isIcd) doc = mk('failed', `\"${code}\" is not a recognised CPT or ICD-10 code format.`);\nelse if (cat.error) doc = mk('unavailable', 'The code catalog did not respond, so the code could not be verified.');\nelse if (!entry) doc = mk('failed', `Code ${code} was not found in the code catalog.`);\nelse doc = mk('warning', 'Replacement entered by the doctor. Supporting evidence has not been machine-verified against the note.');\n\nreturn [{ json: {\n  category: entry?.category ?? (isCpt ? 'CPT' : 'ICD-10'),\n  description: entry?.description ?? 'Unrecognised code',\n  validation: [doc, carry('signed_note', 'Signed note'), carry('billable_event', 'Billable event'), carry('active_policy', 'Active policy')],\n} }];"
      },
      "id": "f1cc3a1f-8feb-5c4b-aab1-1998dfd69c05",
